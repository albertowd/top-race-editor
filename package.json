{
  "name": "top-race-editor",
  "version": "0.1.0",
  "private": true,
  "description": "A track editor: roads as curves over a satellite picture, their lines and rumbles, the meshes the track's build makes",
  "author": "Alberto Wollmann Dietrich",
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "start": "npm run desktop",
    "desktop": "npm run build && node desktop/launch.mjs",
    "build-track": "npm run build && node desktop/launch.mjs --build",
    "package": "npm run build && electron-builder --win --x64 --publish never",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "pictures": "node scripts/model-pictures.mjs",
    "sonar:up": "docker compose up -d --wait sonarqube",
    "sonar:down": "docker compose down",
    "sonar": "npm run test:coverage && node scripts/sonar-reports.mjs && docker compose --profile scan run --rm scanner"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "clipper2-js": "^1.2.4",
    "concurrently": "^10.0.7",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "immer": "^11.2.10",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "triangle-wasm": "^1.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "geos-wasm": "^3.1.1"
  }
}
