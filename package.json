{
	"author": "Alberto Wollmann Dietrich",
	"dependencies": {
		"geos-wasm": "^3.1.1"
	},
	"description": "A track editor, export to Assetto Corsa, BeamNG and rFactor2.",
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.13",
		"@types/node": "^26.6.7",
		"@types/react": "^19.3.1",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/coverage-v8": "^5.1.1",
		"clipper2-js": "^1.2.4",
		"electron": "45.5.0",
		"electron-builder": "^26.18.0",
		"immer": "^11.2.10",
		"jiti": "^2.7.0",
		"jsdom": "^29.1.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"triangle-wasm": "^1.0.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"zustand": "^5.1.0"
	},
	"engines": {
		"node": ">=20"
	},
	"main": "desktop/main.mjs",
	"name": "top-race-editor",
	"private": true,
	"scripts": {
		"build": "tsc -p tsconfig.json && vite build",
		"build-track": "npm run build && node desktop/launch.mjs --build",
		"check": "npm run typecheck && npm run lint && npm run test",
		"desktop": "npm run build && node desktop/launch.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"model:south-warehouse": "jiti scripts/south-warehouse.ts",
		"package": "npm run build && electron-builder --win --x64 --publish never",
		"pictures": "node scripts/model-pictures.mjs",
		"sonar": "npm run test:coverage && node scripts/sonar-reports.mjs && docker compose --profile scan run --rm scanner",
		"sonar:down": "docker compose down",
		"sonar:up": "docker compose up -d --wait sonarqube",
		"start": "npm run desktop",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json"
	},
	"type": "module",
	"version": "0.1.0"
}
